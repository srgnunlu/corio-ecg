# Data and models (large files - NEVER commit)
data/
/models/
*.pth
*.pt
*.onnx
*.h5
*.hdf5
*.dat
*.hea

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
dist/
build/
.eggs/

# Virtual environment
.venv/
venv/
env/

# Environment variables
.env
.env.local

# Jupyter
.ipynb_checkpoints/
*.ipynb_metadata/

# Claude Code local settings (keep skills tracked in git)
.claude/*
!.claude/skills/

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
*.swp
*.swo

