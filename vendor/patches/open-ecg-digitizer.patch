+    def _estimate_rows_from_labels(
+        self,
+        detected: list[tuple[str, float, float]],
+        fallback: int,
+    ) -> int:
+        """Estimate layout row count from detected lead label Y positions.
+
+        Signal extraction can over-detect traces from noise/artifacts,
+        biasing layout matching toward layouts with more rows. Using
+        lead label positions gives a more reliable row count estimate.
+        """
+        if len(detected) < 3:
+            return fallback
+        ys: list[float] = sorted([y for _, _, y in detected])
+        height_range: float = ys[-1] - ys[0]
+        if height_range <= 0:
+            return fallback
+        # Gap > 15% of total label range signals a new row
+        min_gap: float = height_range * 0.15
+        row_count: int = 1
+        for i in range(1, len(ys)):
+            if ys[i] - ys[i - 1] > min_gap:
+                row_count += 1
+        return row_count
