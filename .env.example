# Corio ECG - Environment Variables
# Copy this file to .env and fill in the values

# LLM API Keys (for structured report generation - Phase 5)
# Choose one or more:
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...

# PhysioNet credentials (for downloading MIMIC-IV-ECG)
# Register at https://physionet.org/ and complete required training
# PHYSIONET_USERNAME=
# PHYSIONET_PASSWORD=

# Vast.ai API key (for GPU rental - fine-tuning phases)
# VASTAI_API_KEY=

# Project paths (optional - defaults work for local development)
# DATA_DIR=./data
# MODELS_DIR=./models
# RESULTS_DIR=./results
